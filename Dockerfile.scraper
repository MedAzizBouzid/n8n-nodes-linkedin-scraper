FROM n8nio/n8n:latest-debian

USER root

# Fix Buster repos and install Python & essential deps
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list && \
    apt-get update -o Acquire::Check-Valid-Until=false && \
    apt-get install -y \
        python3 \
        python3-pip \
        # Minimal deps for Chromium
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libdbus-1-3 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        libatspi2.0-0 \
        libxshmfence1 && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip3 install --upgrade pip

# Copy requirements and install Python deps
COPY jobs-scraper/requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

# Install Playwright and browsers (WITHOUT install-deps)
RUN pip3 install --no-cache-dir playwright playwright-stealth && \
    playwright install chromium

# Copy Playwright browsers to node user's cache
RUN mkdir -p /home/node/.cache && \
    cp -r /root/.cache/ms-playwright /home/node/.cache/ && \
    chown -R node:node /home/node/.cache

# Verify installation
RUN python3 -c "from playwright_stealth import stealth_async; print('✅ playwright-stealth OK')"

# Keep running as root (n8n will switch to node user internally)
CMD ["n8n", "start"]
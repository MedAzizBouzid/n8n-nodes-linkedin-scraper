# 1. Start from a standard Node.js image (Debian Bookworm)
# This GUARANTEES that apt-get exists.
FROM node:20-bookworm

USER root

# 2. Install System Dependencies (Python + Playwright Browsers)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    # Dependencies for Chromium/Playwright
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 3. Install n8n globally via npm
# We install the EXACT version you want
RUN npm install -g n8n 

# 4. Set up Python Virtual Environment
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# 5. Install Python Requirements
COPY jobs-scraper/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# 6. Install Playwright & Browsers
RUN playwright install chromium
RUN playwright install-deps chromium

# 7. Create the n8n user and directory
# The 'node' user already exists in this image, we just set permissions
RUN mkdir -p /home/node/.n8n && \
    chown -R node:node /home/node/.n8n /opt/venv

# 8. Define the working directory and user
WORKDIR /home/node
USER node

# 9. Start n8n
ENTRYPOINT ["n8n"]